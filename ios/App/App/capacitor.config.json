{
	"appId": "com.capricorn.vaultcap",
	"appName": "VaultCap",
	"webDir": "www",
	"server": {
		"androidScheme": "https"
	},
	"ios": {
		"contentInset": "never",
		"backgroundColor": "#060a12",
		"scheme": "VaultCap",
		"scrollEnabled": true
	},
	"plugins": {
		"StatusBar": {
			"overlaysWebView": true,
			"style": "DARK"
		}
	},
	"packageClassList": [
		"CAPBrowserPlugin",
		"FilesystemPlugin",
		"HapticsPlugin",
		"SharePlugin",
		"StatusBarPlugin"
	]
}
